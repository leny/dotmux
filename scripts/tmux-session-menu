#!/usr/bin/env bash

# See https://qmacro.org/autodidactics/2021/08/12/session-switching-with-the-tmux-menu/

current_session=$(tmux display-message -p '#S')

TMUX_ALERT_DIR="${TMUX_ALERT_DIR:-/tmp/tmux-alerts}"
TMUX_WORK_DIR="${TMUX_WORK_DIR:-/tmp/tmux-work}"

sessions=$(tmux list-sessions -F '#S' -f '#{?#{m:*_scratchpad,#{session_name}},0,1}')

# macos/system always first, then the rest sorted (so scopes end up contiguous)
ordered=$(
  {
    printf '%s\n' "$sessions" | grep -x 'macos/system'
    printf '%s\n' "$sessions" | grep -vx 'macos/system' | sort
  } | sed '/^$/d'
)

menu_args=()
n=0
prev_scope=""
first=1
while IFS= read -r name; do
  if [[ "$name" == */* ]]; then
    scope="${name%%/*}"
  else
    scope=""
  fi

  # separator whenever the scope changes
  if [[ $first -eq 0 && "$scope" != "$prev_scope" ]]; then
    menu_args+=("")
  fi
  prev_scope="$scope"
  first=0

  n=$((n + 1))
  key=$(printf "\\$(printf '%03o' $((96 + n)))")

  if [[ "$name" == "$current_session" ]]; then
    marker="⏵"
  else
    marker=" "
  fi

  alert_file="$TMUX_ALERT_DIR/$(printf '%s' "$name" | sed 's|/|%2F|g')"
  [[ -f "$alert_file" ]] && has_alert=1 || has_alert=0

  work_file="$TMUX_WORK_DIR/$(printf '%s' "$name" | sed 's|/|%2F|g')"
  [[ -f "$work_file" ]] && has_work=1 || has_work=0

  # needs-attention alert takes priority over the working indicator
  if [[ $has_alert -eq 1 ]]; then
    status="#[fg=yellow]⁂"
  elif [[ $has_work -eq 1 ]]; then
    status="#[fg=green]※"
  else
    status=""
  fi

  # tmux display-menu miscalculates item width past ~5 #[] style tags, silently
  # truncating the line - so the status tag must not add its own #[default] when
  # a scope/project color tag immediately follows (it self-overrides instead)
  if [[ "$name" == */* ]]; then
    project="${name#*/}"
    if [[ -n "$status" ]]; then
      label="${marker}${status} #[fg=magenta]${scope}#[default]/#[fg=cyan]${project}#[default]"
    else
      label="${marker}  #[fg=magenta]${scope}#[default]/#[fg=cyan]${project}#[default]"
    fi
  else
    if [[ -n "$status" ]]; then
      label="${marker}${status}#[default] ${name}"
    else
      label="${marker}  ${name}"
    fi
  fi

  menu_args+=("$label" "$key" "switch-client -t $name")
done <<< "$ordered"

tmux display-menu -T "Switch-session" "${menu_args[@]}"
