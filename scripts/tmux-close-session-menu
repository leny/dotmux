#!/usr/bin/env bash

sessions=$(tmux list-sessions -F '#S' -f '#{?#{m:*_scratchpad,#{session_name}},0,1}')

selected=$(printf '%s\n' "$sessions" | fzf --multi --prompt="Close sessions> " --header="Tab: select · Enter: confirm · Esc: cancel")

[[ -z "$selected" ]] && exit 0

while IFS= read -r name; do
  [[ -n "$name" ]] && tmux kill-session -t "$name"
done <<< "$selected"
